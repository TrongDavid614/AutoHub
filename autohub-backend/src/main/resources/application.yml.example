server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: autohub-backend

  datasource:
    url: jdbc:sqlserver://localhost:1433;databaseName=AutoHubDB;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true
    username: sa
    password: YourPassword123@
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver
    hikari:
      maximum-pool-size: 15
      minimum-idle: 5

  jpa:
    database-platform: org.hibernate.dialect.SQLServerDialect
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true

jwt:
  secret: 404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
  access-token-expiration: 86400000

sepay:
  api-token: your_sepay_api_token_here
  account-number: "5811676579"
  bank-brand-name: "BIDV"

openrouter:
  api:
    key: ${OPENROUTER_API_KEY:your_openrouter_api_key_here}
    url: https://openrouter.ai/api/v1/chat/completions
    model: deepseek/deepseek-chat

cors:
  allowed-origins:
    - "http://localhost:5173"
    - "http://localhost:3000"
